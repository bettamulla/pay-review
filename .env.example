# --- App ---
APP_URL=http://localhost:3000

# IMPORTANT: replace with a strong random secret before deploying.
# Generate one with:  openssl rand -base64 32
# `start.sh` will auto-generate one on first run if you leave this as-is.
AUTH_SECRET=replace-me-run-start-sh-to-generate

# --- Database (Postgres) ---
# Required. On Vercel: add a Postgres database in the Storage tab — it sets
# DATABASE_URL automatically. Locally: any Postgres works (Neon free tier,
# Supabase, Docker, etc.).
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty to use the "console" transport that prints to logs.
# Get a key at https://resend.com (free tier: 3,000/month).
RESEND_API_KEY=
EMAIL_FROM=Pay & Review <hello@example.com>

# --- WhatsApp / SMS (Twilio) ---
# Leave empty to disable — reminders will fall back to email only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# --- Cron auth (optional) ---
# Only needed if you want to trigger the cron endpoint manually from outside Vercel.
# Vercel Cron automatically authenticates via the x-vercel-cron header.
CRON_SECRET=
