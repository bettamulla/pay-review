{
  "name": "payreview",
  "version": "0.1.0",
  "private": true,
  "description": "Get paid faster. Get more reviews. A tiny tool that chases late invoices and asks for reviews on autopilot.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:init": "tsx --env-file=.env.local --env-file=.env src/db/init.ts",
    "db:seed": "tsx --env-file=.env.local --env-file=.env src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "cron:run": "tsx --env-file=.env.local --env-file=.env src/lib/cron-runner.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.0",
    "nanoid": "^5.0.7",
    "next": "^15.0.0",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "twilio": "^5.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "5.7.3"
  }
}
